# udev rules for rovacomd: let the logged-in user open the Palm/HP webOS
# devices that rovacomd attaches (the vendor/product list of the C
# novacomd `usbid_list`, src/host/device_list.c), so that the daemon does
# not need to run as root.
#
# Install (not done by the build):
#   sudo cp contrib/udev/60-rovacomd.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger
#
# TAG+="uaccess" gives the user of the active local session access.
# Alternative for headless hosts: replace TAG+="uaccess" with
#   GROUP="plugdev", MODE="0660"
# and add the daemon's user to the plugdev group, for example:
#   SUBSYSTEM=="usb", ATTR{idVendor}=="0830", ATTR{idProduct}=="8062", GROUP="plugdev", MODE="0660"

SUBSYSTEM=="usb", ATTR{idVendor}=="0830", ATTR{idProduct}=="1000", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0830", ATTR{idProduct}=="0101", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0830", ATTR{idProduct}=="8001", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0830", ATTR{idProduct}=="8002", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="0101", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1209", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8002", TAG+="uaccess"
